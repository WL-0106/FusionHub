<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>TiaAutoGen</AssemblyName>
    <RootNamespace>TiaAutoGen</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- 20 or 21 -->
    <TiaVersion Condition="'$(TiaVersion)' == ''">21</TiaVersion>
    <TiaPortalRoot Condition="'$(TiaPortalRoot)' == ''">C:\Program Files\Siemens\Automation\Portal V$(TiaVersion)</TiaPortalRoot>
    <TiaApiDir Condition="'$(TiaApiDir)' == ''">$(TiaPortalRoot)\PublicAPI\V$(TiaVersion)\net48</TiaApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <None Update="spec.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="scl\**\*.scl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TIA Portal V20/V21 split-assembly layout -->
  <ItemGroup Condition="Exists('$(TiaApiDir)\Siemens.Engineering.Base.dll')">
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaApiDir)\Siemens.Engineering.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7" Condition="Exists('$(TiaApiDir)\Siemens.Engineering.Step7.dll')">
      <HintPath>$(TiaApiDir)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.WinCCUnified" Condition="Exists('$(TiaApiDir)\Siemens.Engineering.WinCCUnified.dll')">
      <HintPath>$(TiaApiDir)\Siemens.Engineering.WinCCUnified.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Older single-assembly layout -->
  <ItemGroup Condition="!Exists('$(TiaApiDir)\Siemens.Engineering.Base.dll') and Exists('$(TiaApiDir)\Siemens.Engineering.dll')">
    <Reference Include="Siemens.Engineering">
      <HintPath>$(TiaApiDir)\Siemens.Engineering.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="VerifyTiaOpenness" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(TiaApiDir)\Siemens.Engineering.Base.dll') and !Exists('$(TiaApiDir)\Siemens.Engineering.dll')"
           Text="TIA Portal Openness assemblies not found under $(TiaApiDir). Install TIA Portal V$(TiaVersion) or pass /p:TiaApiDir=... or /p:TiaVersion=20|21." />
  </Target>

</Project>
