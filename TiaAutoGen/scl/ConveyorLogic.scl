FUNCTION "FC_ConveyorScale" : Real
VAR_INPUT
    Raw : Int;
    RawMin : Int;
    RawMax : Int;
    EngMin : Real;
    EngMax : Real;
END_VAR
VAR_TEMP
    Span : Int;
END_VAR
BEGIN
    Span := RawMax - RawMin;
    IF Span = 0 THEN
        FC_ConveyorScale := 0.0;
    ELSE
        FC_ConveyorScale := EngMin + (INT_TO_REAL(Raw - RawMin) / INT_TO_REAL(Span)) * (EngMax - EngMin);
    END_IF;
END_FUNCTION

