{
  "meta": {
    "table_version": "1.0.0",
    "instrument": "GW INSTEK MFG-2000 系列函数/任意波形发生器",
    "protocol": "SCPI 1994 (partially compatible) / IEEE 488.2-1992",
    "manual": "MFG-2000 系列使用手册-远程接口章节",
    "derived": "代码(协议栈/模拟从站/界面/自动化验证)均由本表派生，修改本表即修改单一事实源",
    "terminator": "LF (CR 可选)",
    "channels": [1, 2],
    "series": {
      "MFG": {
        "label": "MFG-2000 系列",
        "note": "多通道函数信号发生器（CH1/CH2 函数通道+脉冲/RF/功放独立子系统）",
        "freq_max": 320000000.0, "ampl_min": 0.0, "ampl_max": 10.0,
        "offset_abs": 5.0, "pw_min": 0.000002
      },
      "AFG": {
        "label": "AFG-2000 系列",
        "note": "AFG-2225 双通道任意波形发生器（50Ω 负载档；高阻档幅值 20Vpp/偏移 ±10Vpk）",
        "freq_max": 25000000.0, "ampl_min": 0.001, "ampl_max": 10.0,
        "offset_abs": 5.0, "pw_min": 2e-08
      }
    }
  },
  "commands": [
