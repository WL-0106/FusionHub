      "id": "idn",
      "group": "系统",
      "name_cn": "仪器标识",
      "template": false,
      "access": "R",
      "scpi_query": "*IDN?",
      "returns": {"type": "str"},
      "notes": "返回 GW INSTEK,MFG-2000,SN:XXXXXXXX,Vm.mm"
    },
    {
      "id": "rst",
      "group": "系统",
      "name_cn": "复位",
      "template": false,
      "access": "W",
      "scpi_set": "*RST",
      "notes": "恢复出厂默认"
    },
    {
      "id": "cls",
      "group": "系统",
      "name_cn": "清状态/错误队列",
      "template": false,
      "access": "W",
