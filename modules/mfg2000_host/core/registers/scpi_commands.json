      "scpi_query": "SOURce{ch}:FUNCtion?",
      "param": {"type": "enum", "choices": ["SIN", "SQU", "RAMP", "PULS", "NOIS", "USER"], "default": "SIN"},
      "returns": {"type": "enum", "choices": ["SIN", "SQU", "RAMP", "PULS", "NOIS", "USER"]},
      "ui": {"widget": "combo"},
      "notes": "短形式与手册回读形式一致；切换波形会自动关闭互斥调制/扫描/脉冲串模式"
    },
    {
      "id": "freq",
      "group": "基础输出",
      "name_cn": "频率",
      "template": true,
      "access": "RW",
      "scpi_set": "SOURce{ch}:FREQuency {value}",
      "scpi_query": "SOURce{ch}:FREQuency?",
      "param": {"type": "float", "unit": "Hz", "min": 1e-06, "max": 320000000.0, "default": 1000.0, "range_note": "上限随波形模式/型号变化: 正弦方波<=320MHz, 斜波<=1MHz, 脉冲<=25MHz, ARB<=100MHz"},
      "returns": {"type": "float", "unit": "Hz"},
      "ui": {"widget": "spinbox", "decimals": 6}
